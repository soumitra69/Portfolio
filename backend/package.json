{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.9.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
