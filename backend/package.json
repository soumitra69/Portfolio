{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.9.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.js",
    "setup:admin:db": "node --env-file-if-exists=.env scripts/setup-admin-db.js",
    "check:email": "node --env-file-if-exists=.env scripts/check-email.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.0",
    "sharp": "^0.34.0"
  }
