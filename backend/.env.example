PORT=5000
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=admin
# Optional absolute path to the JSON data file.
# DATA_FILE=D:/portfolio-data/portfolio.json

# Supabase Storage connection details. Fill these in backend/.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret: never add this to frontend files or NEXT_PUBLIC variables.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
