PORT=5000
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=portfolio
# Generate privately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# At least 32 characters. Required in production; never use a NEXT_PUBLIC prefix.
JWT_SECRET=
# Comma-separated exact frontend origins. Configure your deployed URL on Render.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://soumitrasamanta69.netlify.app
# Render has a reverse proxy. Set to 1 there; leave empty for direct local use.
TRUST_PROXY=

# Admin provisioning only. Runtime MongoDB auth uses the admins collection.
ADMIN_NAME=Soumitra Samanta
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=
# JSON-mode local development uses only a password hash generated by setup:admin.
ADMIN_PASSWORD_HASH=
# DATA_FILE=/absolute/path/to/portfolio.json

# Optional owner notifications. Supply your SMTP provider's host and credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=soumitrasamanta69@gmail.com

# Opt-in aggregate visitor counts. Enable in frontend and backend environments.
ANALYTICS_ENABLED=false

# Existing optional Supabase settings are preserved; uploads currently use disk.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
