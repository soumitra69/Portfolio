PORT=5000
# Used for JSON-mode login or the one-time setup:admin:db command.
# MongoDB login reads the stored account and does not require these at runtime.
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=
# Optional absolute path to the JSON data file.
# DATA_FILE=D:/portfolio-data/portfolio.json

# Supabase Storage connection details. Fill these in backend/.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret: never add this to frontend files or NEXT_PUBLIC variables.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# MongoDB: leave URI empty to use the local JSON store.
MONGODB_URI=
MONGODB_DB=portfolio
