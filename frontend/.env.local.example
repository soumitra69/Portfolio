# The Next.js server proxies /api requests to the Node.js backend.
BACKEND_URL=https://portfolio-backend-vs7k.onrender.com
# Use http://127.0.0.1:5000 instead when running the backend locally.
# Optional privacy-conscious statistics; also enable on the backend.
# This is read by the server and passed as a boolean, not a secret.
ANALYTICS_ENABLED=false
