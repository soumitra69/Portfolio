    "test:content": "node --test tests/unit/content-source.test.mjs",
    "check:api": "node scripts/check-api.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
