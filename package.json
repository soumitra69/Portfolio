{
  "name": "soumitra-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "start": "concurrently --kill-others -n frontend,backend \"npm run start --workspace frontend\" \"npm run start --workspace backend\"",
    "test": "npm run test --workspace backend",
    "setup:admin": "node backend/scripts/setup-admin.js"
  },
  "engines": { "node": ">=22.9.0" },
  "devDependencies": { "concurrently": "^9.0.0" }
}
